{"pageWidth":612,"pageHeight":792,"items":[{"index":0,"text":"Deep Residual Learning for Image Recognition","x":153.45,"y":675.07,"width":288.33,"height":14.35,"angle":0},{"index":1,"text":"","x":136.39,"y":630.54,"width":0,"height":11.96,"angle":0},{"index":2,"text":"Kaiming He","x":136.39,"y":630.54,"width":58.77,"height":11.96,"angle":0},{"index":3,"text":" ","x":195.16,"y":630.54,"width":26.9,"height":11.96,"angle":0},{"index":4,"text":"Xiangyu Zhang","x":222.06,"y":630.54,"width":74.71,"height":11.96,"angle":0},{"index":5,"text":" ","x":296.77,"y":630.54,"width":26.9,"height":11.96,"angle":0},{"index":6,"text":"Shaoqing Ren","x":323.67,"y":630.54,"width":67.42,"height":11.96,"angle":0},{"index":7,"text":" ","x":391.08,"y":630.54,"width":26.9,"height":11.96,"angle":0},{"index":8,"text":"Jian Sun","x":417.98,"y":630.54,"width":40.85,"height":11.96,"angle":0},{"index":9,"text":"Microsoft Research","x":249.14,"y":613.81,"width":93.96,"height":11.96,"angle":0},{"index":10,"text":"","x":195.49,"y":599.46,"width":0,"height":9.96,"angle":0},{"index":11,"text":"{","x":195.49,"y":599.46,"width":4.98,"height":9.96,"angle":0},{"index":12,"text":"kahe, v-xiangz, v-shren, jiansun","x":200.47,"y":599.46,"width":127.27,"height":9.96,"angle":0},{"index":13,"text":"}","x":327.74,"y":599.46,"width":4.98,"height":9.96,"angle":0},{"index":14,"text":"@microsoft.com","x":332.73,"y":599.46,"width":67.01,"height":9.96,"angle":0},{"index":15,"text":"","x":146,"y":557.58,"width":0,"height":11.96,"angle":0},{"index":16,"text":"Abstract","x":146,"y":557.58,"width":44.49,"height":11.96,"angle":0},{"index":17,"text":"","x":62.07,"y":538.22,"width":0,"height":9.96,"angle":0},{"index":18,"text":"Deeper neural networks are more difficult to train. We","x":62.07,"y":538.22,"width":224.3,"height":9.96,"angle":0},{"index":19,"text":"present a residual learning framework to ease the training","x":50.11,"y":526.27,"width":236.25,"height":9.96,"angle":0},{"index":20,"text":"of networks that are substantially deeper than those used","x":50.11,"y":514.31,"width":236.25,"height":9.96,"angle":0},{"index":21,"text":"previously.","x":50.11,"y":502.36,"width":42.93,"height":9.96,"angle":0},{"index":22,"text":" ","x":93.04,"y":502.36,"width":6.7,"height":9.96,"angle":0},{"index":23,"text":"We explicitly reformulate the layers as learn-","x":99.75,"y":502.36,"width":186.62,"height":9.96,"angle":0},{"index":24,"text":"ing residual functions with reference to the layer inputs, in-","x":50.11,"y":490.4,"width":236.25,"height":9.96,"angle":0},{"index":25,"text":"stead of learning unreferenced functions. We provide com-","x":50.11,"y":478.45,"width":236.25,"height":9.96,"angle":0},{"index":26,"text":"prehensive empirical evidence showing that these residual","x":50.11,"y":466.49,"width":236.25,"height":9.96,"angle":0},{"index":27,"text":"networks are easier to optimize, and can gain accuracy from","x":50.11,"y":454.54,"width":236.25,"height":9.96,"angle":0},{"index":28,"text":"considerably increased depth. On the ImageNet dataset we","x":50.11,"y":442.58,"width":236.25,"height":9.96,"angle":0},{"index":29,"text":"evaluate residual nets with a depth of up to 152 layers—8","x":50.11,"y":430.62,"width":228.5,"height":9.96,"angle":0},{"index":30,"text":"×","x":278.61,"y":430.62,"width":7.75,"height":9.96,"angle":0},{"index":31,"text":"","x":50.11,"y":418.67,"width":0,"height":9.96,"angle":0},{"index":32,"text":"deeper than VGG nets [41] but still having lower complex-","x":50.11,"y":418.67,"width":236.25,"height":9.96,"angle":0},{"index":33,"text":"ity. An ensemble of these residual nets achieves 3.57% error","x":50.11,"y":406.71,"width":236.25,"height":9.96,"angle":0},{"index":34,"text":"on the ImageNet","x":50.11,"y":394.76,"width":64.58,"height":9.96,"angle":0},{"index":35,"text":" ","x":114.69,"y":394.76,"width":2.13,"height":9.96,"angle":0},{"index":36,"text":"test","x":116.82,"y":394.76,"width":13.84,"height":9.96,"angle":0},{"index":37,"text":" ","x":130.66,"y":394.76,"width":1.95,"height":9.96,"angle":0},{"index":38,"text":"set. This result won the 1st place on the","x":132.61,"y":394.76,"width":153.75,"height":9.96,"angle":0},{"index":39,"text":"ILSVRC 2015 classification task. We also present analysis","x":50.11,"y":382.81,"width":236.25,"height":9.96,"angle":0},{"index":40,"text":"on CIFAR-10 with 100 and 1000 layers.","x":50.11,"y":370.85,"width":158.98,"height":9.96,"angle":0},{"index":41,"text":"The depth of representations is of central importance","x":62.07,"y":358.47,"width":224.3,"height":9.96,"angle":0},{"index":42,"text":"for many visual recognition tasks.","x":50.11,"y":346.51,"width":140.69,"height":9.96,"angle":0},{"index":43,"text":" ","x":190.8,"y":346.51,"width":7.47,"height":9.96,"angle":0},{"index":44,"text":"Solely due to our ex-","x":198.28,"y":346.51,"width":88.09,"height":9.96,"angle":0},{"index":45,"text":"tremely deep representations, we obtain a 28% relative im-","x":50.11,"y":334.56,"width":236.25,"height":9.96,"angle":0},{"index":46,"text":"provement on the COCO object detection dataset.","x":50.11,"y":322.6,"width":207.56,"height":9.96,"angle":0},{"index":47,"text":" ","x":257.67,"y":322.6,"width":7.67,"height":9.96,"angle":0},{"index":48,"text":"Deep","x":265.34,"y":322.6,"width":21.02,"height":9.96,"angle":0},{"index":49,"text":"residual nets are foundations of our submissions to ILSVRC","x":50.11,"y":310.65,"width":236.25,"height":9.96,"angle":0},{"index":50,"text":"& COCO 2015 competitions","x":50.11,"y":298.69,"width":116.67,"height":9.96,"angle":0},{"index":51,"text":"1","x":166.78,"y":302.31,"width":3.49,"height":6.97,"angle":0},{"index":52,"text":", where we also won the 1st","x":170.77,"y":298.69,"width":115.6,"height":9.96,"angle":0},{"index":53,"text":"places on the tasks of ImageNet detection, ImageNet local-","x":50.11,"y":286.74,"width":236.25,"height":9.96,"angle":0},{"index":54,"text":"ization, COCO detection, and COCO segmentation.","x":50.11,"y":274.78,"width":206.6,"height":9.96,"angle":0},{"index":55,"text":"","x":50.11,"y":247.6,"width":0,"height":11.96,"angle":0},{"index":56,"text":"1. Introduction","x":50.11,"y":247.6,"width":76.84,"height":11.96,"angle":0},{"index":57,"text":"","x":62.07,"y":228.24,"width":0,"height":9.96,"angle":0},{"index":58,"text":"Deep convolutional neural networks [22, 21] have led","x":62.07,"y":228.24,"width":224.3,"height":9.96,"angle":0},{"index":59,"text":"to a series of breakthroughs for image classification [21,","x":50.11,"y":216.29,"width":236.25,"height":9.96,"angle":0},{"index":60,"text":"50, 40].","x":50.11,"y":204.33,"width":31.73,"height":9.96,"angle":0},{"index":61,"text":" ","x":81.84,"y":204.33,"width":6.15,"height":9.96,"angle":0},{"index":62,"text":"Deep networks naturally integrate low/mid/high-","x":87.99,"y":204.33,"width":198.38,"height":9.96,"angle":0},{"index":63,"text":"level features [50] and classifiers in an end-to-end multi-","x":50.11,"y":192.38,"width":236.25,"height":9.96,"angle":0},{"index":64,"text":"layer fashion, and the “levels” of features can be enriched","x":50.11,"y":180.42,"width":236.25,"height":9.96,"angle":0},{"index":65,"text":"by the number of stacked layers (depth). Recent evidence","x":50.11,"y":168.47,"width":236.25,"height":9.96,"angle":0},{"index":66,"text":"[41, 44] reveals that network depth is of crucial importance,","x":50.11,"y":156.51,"width":236.25,"height":9.96,"angle":0},{"index":67,"text":"and the leading results [41, 44, 13, 16] on the challenging","x":50.11,"y":144.56,"width":236.25,"height":9.96,"angle":0},{"index":68,"text":"ImageNet dataset [36] all exploit “very deep” [41] models,","x":50.11,"y":132.6,"width":236.25,"height":9.96,"angle":0},{"index":69,"text":"with a depth of sixteen [41] to thirty [16]. Many other non-","x":50.11,"y":120.65,"width":236.25,"height":9.96,"angle":0},{"index":70,"text":"trivial visual recognition tasks [8, 12, 7, 32, 27] have also","x":50.11,"y":108.69,"width":236.25,"height":9.96,"angle":0},{"index":71,"text":"","x":60.97,"y":91.78,"width":0,"height":5.98,"angle":0},{"index":72,"text":"1","x":60.97,"y":91.78,"width":2.99,"height":5.98,"angle":0},{"index":73,"text":"http://image-net.org/challenges/LSVRC/2015/","x":64.46,"y":88.97,"width":195.85,"height":7.57,"angle":0},{"index":74,"text":" ","x":260.31,"y":88.97,"width":15.12,"height":7.57,"angle":0},{"index":75,"text":"and","x":275.43,"y":88.97,"width":10.93,"height":7.57,"angle":0},{"index":76,"text":"","x":50.11,"y":81,"width":0,"height":7.57,"angle":0},{"index":77,"text":"http://mscoco.org/dataset/#detections-challenge2015","x":50.11,"y":81,"width":232.19,"height":7.57,"angle":0},{"index":78,"text":".","x":282.3,"y":81,"width":1.89,"height":7.57,"angle":0},{"index":79,"text":"0","x":319.34,"y":497.32,"width":1.67,"height":3.34,"angle":0},{"index":80,"text":" ","x":321.01,"y":497.32,"width":4.26,"height":3.34,"angle":0},{"index":81,"text":"1","x":335.22,"y":497.32,"width":1.67,"height":3.34,"angle":0},{"index":82,"text":" ","x":336.89,"y":497.32,"width":4.28,"height":3.34,"angle":0},{"index":83,"text":"2","x":351.2,"y":497.32,"width":1.67,"height":3.34,"angle":0},{"index":84,"text":" ","x":352.87,"y":497.32,"width":4.26,"height":3.34,"angle":0},{"index":85,"text":"3","x":367.08,"y":497.32,"width":1.67,"height":3.34,"angle":0},{"index":86,"text":" ","x":368.75,"y":497.32,"width":4.28,"height":3.34,"angle":0},{"index":87,"text":"4","x":383.06,"y":497.32,"width":1.67,"height":3.34,"angle":0},{"index":88,"text":" ","x":384.73,"y":497.32,"width":4.28,"height":3.34,"angle":0},{"index":89,"text":"5","x":399.03,"y":497.32,"width":1.67,"height":3.34,"angle":0},{"index":90,"text":" ","x":400.7,"y":497.32,"width":4.26,"height":3.34,"angle":0},{"index":91,"text":"6","x":414.92,"y":497.32,"width":1.67,"height":3.34,"angle":0},{"index":92,"text":"0","x":317.05,"y":499.52,"width":1.67,"height":3.34,"angle":0},{"index":93,"text":"10","x":316.26,"y":532.08,"width":3.34,"height":3.34,"angle":0},{"index":94,"text":"20","x":316.26,"y":564.56,"width":3.34,"height":3.34,"angle":0},{"index":95,"text":"iter. (1e4)","x":357.87,"y":491.36,"width":26.06,"height":6.55,"angle":0},{"index":96,"text":"training error (%)","x":313.98,"y":509.88,"width":46.6,"height":6.55,"angle":90},{"index":97,"text":"","x":441.16,"y":497.32,"width":0,"height":3.34,"angle":0},{"index":98,"text":"0","x":441.16,"y":497.32,"width":1.67,"height":3.34,"angle":0},{"index":99,"text":" ","x":442.83,"y":497.32,"width":4.26,"height":3.34,"angle":0},{"index":100,"text":"1","x":457.05,"y":497.32,"width":1.67,"height":3.34,"angle":0},{"index":101,"text":" ","x":458.72,"y":497.32,"width":4.28,"height":3.34,"angle":0},{"index":102,"text":"2","x":473.02,"y":497.32,"width":1.67,"height":3.34,"angle":0},{"index":103,"text":" ","x":474.69,"y":497.32,"width":4.26,"height":3.34,"angle":0},{"index":104,"text":"3","x":488.91,"y":497.32,"width":1.67,"height":3.34,"angle":0},{"index":105,"text":" ","x":490.58,"y":497.32,"width":4.28,"height":3.34,"angle":0},{"index":106,"text":"4","x":504.88,"y":497.32,"width":1.67,"height":3.34,"angle":0},{"index":107,"text":" ","x":506.55,"y":497.32,"width":4.28,"height":3.34,"angle":0},{"index":108,"text":"5","x":520.86,"y":497.32,"width":1.67,"height":3.34,"angle":0},{"index":109,"text":" ","x":522.53,"y":497.32,"width":4.26,"height":3.34,"angle":0},{"index":110,"text":"6","x":536.75,"y":497.32,"width":1.67,"height":3.34,"angle":0},{"index":111,"text":"0","x":439.76,"y":499.52,"width":1.67,"height":3.34,"angle":0},{"index":112,"text":"10","x":438.09,"y":532.08,"width":3.34,"height":3.34,"angle":0},{"index":113,"text":"20","x":438.09,"y":564.56,"width":3.34,"height":3.34,"angle":0},{"index":114,"text":"iter. (1e4)","x":479.69,"y":491.36,"width":26.06,"height":6.55,"angle":0},{"index":115,"text":"test error (%)","x":435.81,"y":515.49,"width":35.21,"height":6.55,"angle":90},{"index":116,"text":"","x":400.26,"y":523.48,"width":0,"height":6.58,"angle":0},{"index":117,"text":"56-layer","x":400.26,"y":523.48,"width":21.93,"height":6.58,"angle":0},{"index":118,"text":"20-layer","x":400.26,"y":508.03,"width":21.93,"height":6.58,"angle":0},{"index":119,"text":"56-layer","x":521.65,"y":546.3,"width":21.93,"height":6.58,"angle":0},{"index":120,"text":"20-layer","x":521.65,"y":534.36,"width":21.93,"height":6.58,"angle":0},{"index":121,"text":"","x":308.86,"y":480.31,"width":0,"height":8.97,"angle":0},{"index":122,"text":"Figure 1. Training error (left) and test error (right) on CIFAR-10","x":308.86,"y":480.31,"width":236.25,"height":8.97,"angle":0},{"index":123,"text":"with 20-layer and 56-layer “plain” networks. The deeper network","x":308.86,"y":469.35,"width":236.25,"height":8.97,"angle":0},{"index":124,"text":"has higher training error, and thus test error. Similar phenomena","x":308.86,"y":458.39,"width":236.25,"height":8.97,"angle":0},{"index":125,"text":"on ImageNet is presented in Fig. 4.","x":308.86,"y":447.43,"width":126.01,"height":8.97,"angle":0},{"index":126,"text":"","x":308.86,"y":421.64,"width":0,"height":9.96,"angle":0},{"index":127,"text":"greatly benefited from very deep models.","x":308.86,"y":421.64,"width":163.65,"height":9.96,"angle":0},{"index":128,"text":"Driven by the significance of depth, a question arises:","x":320.82,"y":407.72,"width":213.91,"height":9.96,"angle":0},{"index":129,"text":" ","x":534.72,"y":407.72,"width":3.2,"height":9.96,"angle":0},{"index":130,"text":"Is","x":537.92,"y":407.72,"width":7.19,"height":9.96,"angle":0},{"index":131,"text":"learning better networks as easy as stacking more layers?","x":308.86,"y":395.76,"width":236.25,"height":9.96,"angle":0},{"index":132,"text":"","x":308.86,"y":383.81,"width":0,"height":9.96,"angle":0},{"index":133,"text":"An obstacle to answering this question was the notorious","x":308.86,"y":383.81,"width":236.25,"height":9.96,"angle":0},{"index":134,"text":"problem of vanishing/exploding gradients [1, 9], which","x":308.86,"y":371.85,"width":236.25,"height":9.96,"angle":0},{"index":135,"text":"hamper convergence from the beginning.","x":308.86,"y":359.9,"width":170.22,"height":9.96,"angle":0},{"index":136,"text":" ","x":479.08,"y":359.9,"width":8.37,"height":9.96,"angle":0},{"index":137,"text":"This problem,","x":487.45,"y":359.9,"width":57.66,"height":9.96,"angle":0},{"index":138,"text":"however, has been largely addressed by normalized initial-","x":308.86,"y":347.94,"width":236.25,"height":9.96,"angle":0},{"index":139,"text":"ization [23, 9, 37, 13] and intermediate normalization layers","x":308.86,"y":335.99,"width":236.25,"height":9.96,"angle":0},{"index":140,"text":"[16], which enable networks with tens of layers to start con-","x":308.86,"y":324.03,"width":236.25,"height":9.96,"angle":0},{"index":141,"text":"verging for stochastic gradient descent (SGD) with back-","x":308.86,"y":312.08,"width":236.25,"height":9.96,"angle":0},{"index":142,"text":"propagation [22].","x":308.86,"y":300.12,"width":69.12,"height":9.96,"angle":0},{"index":143,"text":"When deeper networks are able to start converging, a","x":320.82,"y":286.2,"width":224.3,"height":9.96,"angle":0},{"index":144,"text":"","x":308.86,"y":274.25,"width":0,"height":9.96,"angle":0},{"index":145,"text":"degradation","x":308.86,"y":274.25,"width":48.16,"height":9.96,"angle":0},{"index":146,"text":" ","x":357.02,"y":274.25,"width":3.37,"height":9.96,"angle":0},{"index":147,"text":"problem has been exposed: with the network","x":360.39,"y":274.25,"width":184.72,"height":9.96,"angle":0},{"index":148,"text":"depth increasing, accuracy gets saturated (which might be","x":308.86,"y":262.29,"width":236.25,"height":9.96,"angle":0},{"index":149,"text":"unsurprising) and then degrades rapidly.","x":308.86,"y":250.34,"width":169.2,"height":9.96,"angle":0},{"index":150,"text":" ","x":478.07,"y":250.34,"width":10.02,"height":9.96,"angle":0},{"index":151,"text":"Unexpectedly,","x":488.09,"y":250.34,"width":57.03,"height":9.96,"angle":0},{"index":152,"text":"such degradation is","x":308.86,"y":238.38,"width":79.16,"height":9.96,"angle":0},{"index":153,"text":" ","x":388.02,"y":238.38,"width":3.69,"height":9.96,"angle":0},{"index":154,"text":"not caused by overfitting","x":391.72,"y":238.38,"width":101.73,"height":9.96,"angle":0},{"index":155,"text":", and adding","x":493.44,"y":238.38,"width":51.67,"height":9.96,"angle":0},{"index":156,"text":"more layers to a suitably deep model leads to","x":308.86,"y":226.43,"width":182.14,"height":9.96,"angle":0},{"index":157,"text":" ","x":491,"y":226.43,"width":2.78,"height":9.96,"angle":0},{"index":158,"text":"higher train-","x":493.78,"y":226.43,"width":51.34,"height":9.96,"angle":0},{"index":159,"text":"ing error","x":308.86,"y":214.47,"width":35.7,"height":9.96,"angle":0},{"index":160,"text":", as reported in [11, 42] and thoroughly verified by","x":344.55,"y":214.47,"width":200.56,"height":9.96,"angle":0},{"index":161,"text":"our experiments. Fig. 1 shows a typical example.","x":308.86,"y":202.52,"width":195.41,"height":9.96,"angle":0},{"index":162,"text":"The degradation (of training accuracy) indicates that not","x":320.82,"y":188.6,"width":224.3,"height":9.96,"angle":0},{"index":163,"text":"all systems are similarly easy to optimize. Let us consider a","x":308.86,"y":176.64,"width":236.25,"height":9.96,"angle":0},{"index":164,"text":"shallower architecture and its deeper counterpart that adds","x":308.86,"y":164.69,"width":236.25,"height":9.96,"angle":0},{"index":165,"text":"more layers onto it. There exists a solution","x":308.86,"y":152.73,"width":171.75,"height":9.96,"angle":0},{"index":166,"text":" ","x":480.61,"y":152.73,"width":2.64,"height":9.96,"angle":0},{"index":167,"text":"by construction","x":483.25,"y":152.73,"width":61.87,"height":9.96,"angle":0},{"index":168,"text":"","x":308.86,"y":140.78,"width":0,"height":9.96,"angle":0},{"index":169,"text":"to the deeper model: the added layers are","x":308.86,"y":140.78,"width":164.04,"height":9.96,"angle":0},{"index":170,"text":" ","x":472.91,"y":140.78,"width":2.48,"height":9.96,"angle":0},{"index":171,"text":"identity","x":475.38,"y":140.78,"width":29.89,"height":9.96,"angle":0},{"index":172,"text":" ","x":505.27,"y":140.78,"width":2.48,"height":9.96,"angle":0},{"index":173,"text":"mapping,","x":507.75,"y":140.78,"width":37.36,"height":9.96,"angle":0},{"index":174,"text":"and the other layers are copied from the learned shallower","x":308.86,"y":128.82,"width":236.25,"height":9.96,"angle":0},{"index":175,"text":"model. The existence of this constructed solution indicates","x":308.86,"y":116.86,"width":236.25,"height":9.96,"angle":0},{"index":176,"text":"that a deeper model should produce no higher training error","x":308.86,"y":104.91,"width":236.25,"height":9.96,"angle":0},{"index":177,"text":"than its shallower counterpart. But experiments show that","x":308.86,"y":92.95,"width":236.25,"height":9.96,"angle":0},{"index":178,"text":"our current solvers on hand are unable to find solutions that","x":308.86,"y":81,"width":236.25,"height":9.96,"angle":0},{"index":179,"text":"1","x":295.12,"y":51.11,"width":4.98,"height":9.96,"angle":0},{"index":180,"text":"","x":32,"y":232,"width":0,"height":20,"angle":90},{"index":181,"text":"arXiv:1512.03385v1 [cs.CV] 10 Dec 2015","x":32,"y":232,"width":351.06,"height":20,"angle":90}]}