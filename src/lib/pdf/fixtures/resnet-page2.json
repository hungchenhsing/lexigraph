ex":86,"text":") +","x":157.81,"y":420.08,"width":13.06,"height":9.96,"angle":0},{"index":87,"text":" ","x":170.87,"y":420.08,"width":1.44,"height":9.96,"angle":0},{"index":88,"text":"x","x":172.31,"y":420.08,"width":6.05,"height":9.96,"angle":0},{"index":89,"text":" ","x":178.35,"y":420.08,"width":2.28,"height":9.96,"angle":0},{"index":90,"text":"can be realized by feedfor-","x":180.63,"y":420.08,"width":105.73,"height":9.96,"angle":0},{"index":91,"text":"ward neural networks with “shortcut connections” (Fig. 2).","x":50.11,"y":408.12,"width":236.25,"height":9.96,"angle":0},{"index":92,"text":"Shortcut connections [2, 34, 49] are those skipping one or","x":50.11,"y":396.17,"width":236.25,"height":9.96,"angle":0},{"index":93,"text":"more layers. In our case, the shortcut connections simply","x":50.11,"y":384.21,"width":236.25,"height":9.96,"angle":0},{"index":94,"text":"perform","x":50.11,"y":372.25,"width":32.09,"height":9.96,"angle":0},{"index":95,"text":" ","x":82.2,"y":372.25,"width":3.86,"height":9.96,"angle":0},{"index":96,"text":"identity","x":86.06,"y":372.25,"width":29.89,"height":9.96,"angle":0},{"index":97,"text":" ","x":115.95,"y":372.25,"width":3.86,"height":9.96,"angle":0},{"index":98,"text":"mapping, and their outputs are added to","x":119.81,"y":372.25,"width":166.55,"height":9.96,"angle":0},{"index":99,"text":"the outputs of the stacked layers (Fig. 2).","x":50.11,"y":360.3,"width":171.51,"height":9.96,"angle":0},{"index":100,"text":" ","x":221.62,"y":360.3,"width":6.78,"height":9.96,"angle":0},{"index":101,"text":"Identity short-","x":228.4,"y":360.3,"width":57.96,"height":9.96,"angle":0},{"index":102,"text":"cut connections add neither extra parameter nor computa-","x":50.11,"y":348.34,"width":236.25,"height":9.96,"angle":0},{"index":103,"text":"tional complexity.","x":50.11,"y":336.39,"width":72.71,"height":9.96,"angle":0},{"index":104,"text":" ","x":122.82,"y":336.39,"width":6.07,"height":9.96,"angle":0},{"index":105,"text":"The entire network can still be trained","x":128.89,"y":336.39,"width":157.48,"height":9.96,"angle":0},{"index":106,"text":"end-to-end by SGD with backpropagation, and can be eas-","x":50.11,"y":324.43,"width":236.25,"height":9.96,"angle":0},{"index":107,"text":"ily implemented using common libraries (","x":50.11,"y":312.48,"width":171.1,"height":9.96,"angle":0},{"index":108,"text":"e.g","x":221.21,"y":312.48,"width":11.75,"height":9.96,"angle":0},{"index":109,"text":"., Caffe [19])","x":232.95,"y":312.48,"width":53.41,"height":9.96,"angle":0},{"index":110,"text":"without modifying the solvers.","x":50.11,"y":300.52,"width":122.17,"height":9.96,"angle":0},{"index":111,"text":"We present comprehensive experiments on ImageNet","x":62.07,"y":287.12,"width":224.3,"height":9.96,"angle":0},{"index":112,"text":"[36] to show the degradation problem and evaluate our","x":50.11,"y":275.17,"width":236.25,"height":9.96,"angle":0},{"index":113,"text":"method. We show that: 1) Our extremely deep residual nets","x":50.11,"y":263.21,"width":236.25,"height":9.96,"angle":0},{"index":114,"text":"are easy to optimize, but the counterpart “plain” nets (that","x":50.11,"y":251.26,"width":236.25,"height":9.96,"angle":0},{"index":115,"text":"simply stack layers) exhibit higher training error when the","x":50.11,"y":239.3,"width":236.25,"height":9.96,"angle":0},{"index":116,"text":"depth increases; 2) Our deep residual nets can easily enjoy","x":50.11,"y":227.35,"width":236.25,"height":9.96,"angle":0},{"index":117,"text":"accuracy gains from greatly increased depth, producing re-","x":50.11,"y":215.39,"width":236.25,"height":9.96,"angle":0},{"index":118,"text":"sults substantially better than previous networks.","x":50.11,"y":203.44,"width":193.91,"height":9.96,"angle":0},{"index":119,"text":"Similar phenomena are also shown on the CIFAR-10 set","x":62.07,"y":190.04,"width":224.3,"height":9.96,"angle":0},{"index":120,"text":"[20], suggesting that the optimization difficulties and the","x":50.11,"y":178.08,"width":236.25,"height":9.96,"angle":0},{"index":121,"text":"effects of our method are not just akin to a particular dataset.","x":50.11,"y":166.13,"width":236.25,"height":9.96,"angle":0},{"index":122,"text":"We present successfully trained models on this dataset with","x":50.11,"y":154.17,"width":236.25,"height":9.96,"angle":0},{"index":123,"text":"over 100 layers, and explore models with over 1000 layers.","x":50.11,"y":142.22,"width":235.27,"height":9.96,"angle":0},{"index":124,"text":"On the ImageNet classification dataset [36], we obtain","x":62.07,"y":128.82,"width":224.3,"height":9.96,"angle":0},{"index":125,"text":"excellent results by extremely deep residual nets. Our 152-","x":50.11,"y":116.86,"width":236.25,"height":9.96,"angle":0},{"index":126,"text":"layer residual net is the deepest network ever presented on","x":50.11,"y":104.91,"width":236.25,"height":9.96,"angle":0},{"index":127,"text":"ImageNet, while still having lower complexity than VGG","x":50.11,"y":92.95,"width":236.25,"height":9.96,"angle":0},{"index":128,"text":"nets [41].","x":50.11,"y":81,"width":39.61,"height":9.96,"angle":0},{"index":129,"text":" ","x":89.72,"y":81,"width":9.03,"height":9.96,"angle":0},{"index":130,"text":"Our ensemble has","x":98.75,"y":81,"width":75.34,"height":9.96,"angle":0},{"index":131,"text":" ","x":174.09,"y":81,"width":4.47,"height":9.96,"angle":0},{"index":132,"text":"3.57%","x":178.56,"y":81,"width":27.4,"height":9.96,"angle":0},{"index":133,"text":" ","x":205.96,"y":81,"width":4.47,"height":9.96,"angle":0},{"index":134,"text":"top-5 error on the","x":210.43,"y":81,"width":75.93,"height":9.96,"angle":0},{"index":135,"text":"ImageNet","x":308.86,"y":710.04,"width":39.28,"height":9.96,"angle":0},{"index":136,"text":" ","x":348.14,"y":710.04,"width":4.01,"height":9.96,"angle":0},{"index":137,"text":"test","x":352.15,"y":710.04,"width":13.84,"height":9.96,"angle":0},{"index":138,"text":" ","x":365.99,"y":710.04,"width":4.18,"height":9.96,"angle":0},{"index":139,"text":"set, and","x":370.17,"y":710.04,"width":32.33,"height":9.96,"angle":0},{"index":140,"text":" ","x":402.5,"y":710.04,"width":4.01,"height":9.96,"angle":0},{"index":141,"text":"won the 1st place in the ILSVRC","x":406.51,"y":710.04,"width":138.6,"height":9.96,"angle":0},{"index":142,"text":"2015 classification competition","x":308.86,"y":698.08,"width":126.69,"height":9.96,"angle":0},{"index":143,"text":".","x":435.55,"y":698.08,"width":2.49,"height":9.96,"angle":0},{"index":144,"text":" ","x":438.04,"y":698.08,"width":6.33,"height":9.96,"angle":0},{"index":145,"text":"The extremely deep rep-","x":444.37,"y":698.08,"width":100.74,"height":9.96,"angle":0},{"index":146,"text":"resentations also have excellent generalization performance","x":308.86,"y":686.13,"width":236.25,"height":9.96,"angle":0},{"index":147,"text":"on other recognition tasks, and lead us to further","x":308.86,"y":674.17,"width":202.39,"height":9.96,"angle":0},{"index":148,"text":" ","x":511.25,"y":674.17,"width":3.64,"height":9.96,"angle":0},{"index":149,"text":"win the","x":514.9,"y":674.17,"width":30.22,"height":9.96,"angle":0},{"index":150,"text":"1st places on: ImageNet detection, ImageNet localization,","x":308.86,"y":662.22,"width":236.25,"height":9.96,"angle":0},{"index":151,"text":"COCO detection, and COCO segmentation","x":308.86,"y":650.26,"width":175.43,"height":9.96,"angle":0},{"index":152,"text":" ","x":484.29,"y":650.26,"width":3.3,"height":9.96,"angle":0},{"index":153,"text":"in ILSVRC &","x":487.59,"y":650.26,"width":57.52,"height":9.96,"angle":0},{"index":154,"text":"COCO 2015 competitions. This strong evidence shows that","x":308.86,"y":638.31,"width":236.25,"height":9.96,"angle":0},{"index":155,"text":"the residual learning principle is generic, and we expect that","x":308.86,"y":626.35,"width":236.25,"height":9.96,"angle":0},{"index":156,"text":"it is applicable in other vision and non-vision problems.","x":308.86,"y":614.4,"width":222.22,"height":9.96,"angle":0},{"index":157,"text":"","x":308.86,"y":587.75,"width":0,"height":11.96,"angle":0},{"index":158,"text":"2. Related Work","x":308.86,"y":587.75,"width":83.11,"height":11.96,"angle":0},{"index":159,"text":"","x":308.86,"y":567.91,"width":0,"height":9.96,"angle":0},{"index":160,"text":"Residual Representations.","x":308.86,"y":567.91,"width":111.48,"height":9.96,"angle":0},{"index":161,"text":" ","x":420.34,"y":567.91,"width":5.98,"height":9.96,"angle":0},{"index":162,"text":"In image recognition, VLAD","x":426.32,"y":567.91,"width":118.79,"height":9.96,"angle":0},{"index":163,"text":"[18] is a representation that encodes by the residual vectors","x":308.86,"y":555.96,"width":236.25,"height":9.96,"angle":0},{"index":164,"text":"with respect to a dictionary, and Fisher Vector [30] can be","x":308.86,"y":544,"width":236.25,"height":9.96,"angle":0},{"index":165,"text":"formulated as a probabilistic version [18] of VLAD. Both","x":308.86,"y":532.05,"width":236.25,"height":9.96,"angle":0},{"index":166,"text":"of them are powerful shallow representations for image re-","x":308.86,"y":520.09,"width":236.25,"height":9.96,"angle":0},{"index":167,"text":"trieval and classification [4, 48].","x":308.86,"y":508.14,"width":132.38,"height":9.96,"angle":0},{"index":168,"text":" ","x":441.25,"y":508.14,"width":6.46,"height":9.96,"angle":0},{"index":169,"text":"For vector quantization,","x":447.7,"y":508.14,"width":97.41,"height":9.96,"angle":0},{"index":170,"text":"encoding residual vectors [17] is shown to be more effec-","x":308.86,"y":496.18,"width":236.25,"height":9.96,"angle":0},{"index":171,"text":"tive than encoding original vectors.","x":308.86,"y":484.23,"width":140.29,"height":9.96,"angle":0},{"index":172,"text":"In low-level vision and computer graphics, for solv-","x":320.82,"y":471.36,"width":224.3,"height":9.96,"angle":0},{"index":173,"text":"ing Partial Differential Equations (PDEs), the widely used","x":308.86,"y":459.41,"width":236.25,"height":9.96,"angle":0},{"index":174,"text":"Multigrid method [3] reformulates the system as subprob-","x":308.86,"y":447.45,"width":236.25,"height":9.96,"angle":0},{"index":175,"text":"lems at multiple scales, where each subproblem is respon-","x":308.86,"y":435.5,"width":236.25,"height":9.96,"angle":0},{"index":176,"text":"sible for the residual solution between a coarser and a finer","x":308.86,"y":423.54,"width":236.25,"height":9.96,"angle":0},{"index":177,"text":"scale. An alternative to Multigrid is hierarchical basis pre-","x":308.86,"y":411.59,"width":236.25,"height":9.96,"angle":0},{"index":178,"text":"conditioning [45, 46], which relies on variables that repre-","x":308.86,"y":399.63,"width":236.25,"height":9.96,"angle":0},{"index":179,"text":"sent residual vectors between two scales. It has been shown","x":308.86,"y":387.68,"width":236.25,"height":9.96,"angle":0},{"index":180,"text":"[3, 45, 46] that these solvers converge much faster than stan-","x":308.86,"y":375.72,"width":236.25,"height":9.96,"angle":0},{"index":181,"text":"dard solvers that are unaware of the residual nature of the","x":308.86,"y":363.77,"width":236.25,"height":9.96,"angle":0},{"index":182,"text":"solutions. These methods suggest that a good reformulation","x":308.86,"y":351.81,"width":236.25,"height":9.96,"angle":0},{"index":183,"text":"or preconditioning can simplify the optimization.","x":308.86,"y":339.86,"width":195.92,"height":9.96,"angle":0},{"index":184,"text":"","x":308.86,"y":321.01,"width":0,"height":9.96,"angle":0},{"index":185,"text":"Shortcut Connections.","x":308.86,"y":321.01,"width":95.18,"height":9.96,"angle":0},{"index":186,"text":" ","x":404.04,"y":321.01,"width":4.72,"height":9.96,"angle":0},{"index":187,"text":"Practices and theories that lead to","x":408.76,"y":321.01,"width":136.35,"height":9.96,"angle":0},{"index":188,"text":"shortcut connections [2, 34, 49] have been studied for a long","x":308.86,"y":309.06,"width":236.25,"height":9.96,"angle":0},{"index":189,"text":"time. An early practice of training multi-layer perceptrons","x":308.86,"y":297.1,"width":236.25,"height":9.96,"angle":0},{"index":190,"text":"(MLPs) is to add a linear layer connected from the network","x":308.86,"y":285.15,"width":236.25,"height":9.96,"angle":0},{"index":191,"text":"input to the output [34, 49].","x":308.86,"y":273.19,"width":116.71,"height":9.96,"angle":0},{"index":192,"text":" ","x":425.57,"y":273.19,"width":7.19,"height":9.96,"angle":0},{"index":193,"text":"In [44, 24], a few interme-","x":432.77,"y":273.19,"width":112.35,"height":9.96,"angle":0},{"index":194,"text":"diate layers are directly connected to auxiliary classifiers","x":308.86,"y":261.24,"width":236.25,"height":9.96,"angle":0},{"index":195,"text":"for addressing vanishing/exploding gradients.","x":308.86,"y":249.28,"width":184.9,"height":9.96,"angle":0},{"index":196,"text":" ","x":493.76,"y":249.28,"width":6.3,"height":9.96,"angle":0},{"index":197,"text":"The papers","x":500.05,"y":249.28,"width":45.06,"height":9.96,"angle":0},{"index":198,"text":"of [39, 38, 31, 47] propose methods for centering layer re-","x":308.86,"y":237.33,"width":236.25,"height":9.96,"angle":0},{"index":199,"text":"sponses, gradients, and propagated errors, implemented by","x":308.86,"y":225.37,"width":236.25,"height":9.96,"angle":0},{"index":200,"text":"shortcut connections. In [44], an “inception” layer is com-","x":308.86,"y":213.42,"width":236.25,"height":9.96,"angle":0},{"index":201,"text":"posed of a shortcut branch and a few deeper branches.","x":308.86,"y":201.46,"width":215.53,"height":9.96,"angle":0},{"index":202,"text":"Concurrent with our work, “highway networks” [42, 43]","x":320.82,"y":188.6,"width":224.3,"height":9.96,"angle":0},{"index":203,"text":"present shortcut connections with gating functions [15].","x":308.86,"y":176.64,"width":236.25,"height":9.96,"angle":0},{"index":204,"text":"These gates are data-dependent and have parameters, in","x":308.86,"y":164.69,"width":236.25,"height":9.96,"angle":0},{"index":205,"text":"contrast to our identity shortcuts that are parameter-free.","x":308.86,"y":152.73,"width":236.25,"height":9.96,"angle":0},{"index":206,"text":"When a gated shortcut is “closed” (approaching zero), the","x":308.86,"y":140.77,"width":236.25,"height":9.96,"angle":0},{"index":207,"text":"layers in highway networks represent","x":308.86,"y":128.82,"width":156,"height":9.96,"angle":0},{"index":208,"text":" ","x":464.87,"y":128.82,"width":4.33,"height":9.96,"angle":0},{"index":209,"text":"non-residual","x":469.2,"y":128.82,"width":50.55,"height":9.96,"angle":0},{"index":210,"text":" ","x":519.75,"y":128.82,"width":4.34,"height":9.96,"angle":0},{"index":211,"text":"func-","x":524.09,"y":128.82,"width":21.02,"height":9.96,"angle":0},{"index":212,"text":"tions.","x":308.86,"y":116.86,"width":21.87,"height":9.96,"angle":0},{"index":213,"text":" ","x":330.73,"y":116.86,"width":11.32,"height":9.96,"angle":0},{"index":214,"text":"On the contrary, our formulation always learns","x":342.05,"y":116.86,"width":203.07,"height":9.96,"angle":0},{"index":215,"text":"residual functions; our identity shortcuts are never closed,","x":308.86,"y":104.91,"width":236.25,"height":9.96,"angle":0},{"index":216,"text":"and all information is always passed through, with addi-","x":308.86,"y":92.95,"width":236.25,"height":9.96,"angle":0},{"index":217,"text":"tional residual functions to be learned.","x":308.86,"y":81,"width":158.09,"height":9.96,"angle":0},{"index":218,"text":" ","x":466.95,"y":81,"width":6.3,"height":9.96,"angle":0},{"index":219,"text":"In addition, high-","x":473.24,"y":81,"width":71.87,"height":9.96,"angle":0},{"index":220,"text":"2","x":295.12,"y":51.11,"width":4.98,"height":9.96,"angle":0}]}