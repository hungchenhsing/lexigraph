ight":9.96,"angle":0},{"index":44,"text":"University of Toronto","x":244.57,"y":488.4,"width":86.25,"height":9.96,"angle":0},{"index":45,"text":"","x":235.41,"y":477.49,"width":0,"height":9.96,"angle":0},{"index":46,"text":"aidan@cs.toronto.edu","x":235.41,"y":477.49,"width":104.59,"height":9.96,"angle":0},{"index":47,"text":"","x":394.12,"y":499.31,"width":0,"height":9.96,"angle":0},{"index":48,"text":"Łukasz Kaiser","x":394.12,"y":499.31,"width":61.72,"height":9.96,"angle":0},{"index":49,"text":"∗","x":455.84,"y":502.92,"width":4.08,"height":6.97,"angle":0},{"index":50,"text":"","x":398,"y":488.4,"width":0,"height":9.96,"angle":0},{"index":51,"text":"Google Brain","x":398,"y":488.4,"width":53.96,"height":9.96,"angle":0},{"index":52,"text":"","x":364.85,"y":477.49,"width":0,"height":9.96,"angle":0},{"index":53,"text":"lukaszkaiser@google.com","x":364.85,"y":477.49,"width":120.27,"height":9.96,"angle":0},{"index":54,"text":"","x":268.81,"y":449.31,"width":0,"height":9.96,"angle":0},{"index":55,"text":"Illia Polosukhin","x":268.81,"y":449.31,"width":67.08,"height":9.96,"angle":0},{"index":56,"text":"∗ ‡","x":335.88,"y":452.93,"width":10.96,"height":6.97,"angle":0},{"index":57,"text":"","x":238.02,"y":438.4,"width":0,"height":9.96,"angle":0},{"index":58,"text":"illia.polosukhin@gmail.com","x":238.02,"y":438.4,"width":135.95,"height":9.96,"angle":0},{"index":59,"text":"","x":283.76,"y":397.22,"width":0,"height":11.96,"angle":0},{"index":60,"text":"Abstract","x":283.76,"y":397.22,"width":44.49,"height":11.96,"angle":0},{"index":61,"text":"","x":143.56,"y":371.04,"width":0,"height":9.96,"angle":0},{"index":62,"text":"The dominant sequence transduction models are based on complex recurrent or","x":143.56,"y":371.04,"width":324.74,"height":9.96,"angle":0},{"index":63,"text":"convolutional neural networks that include an encoder and a decoder. The best","x":143.87,"y":360.13,"width":324.26,"height":9.96,"angle":0},{"index":64,"text":"performing models also connect the encoder and decoder through an attention","x":143.87,"y":349.22,"width":324.26,"height":9.96,"angle":0},{"index":65,"text":"mechanism. We propose a new simple network architecture, the Transformer,","x":143.87,"y":338.31,"width":325.51,"height":9.96,"angle":0},{"index":66,"text":"based solely on attention mechanisms, dispensing with recurrence and convolutions","x":143.87,"y":327.4,"width":324.27,"height":9.96,"angle":0},{"index":67,"text":"entirely.","x":143.87,"y":316.49,"width":32.93,"height":9.96,"angle":0},{"index":68,"text":" ","x":176.8,"y":316.49,"width":6.01,"height":9.96,"angle":0},{"index":69,"text":"Experiments on two machine translation tasks show these models to","x":182.93,"y":316.49,"width":285.2,"height":9.96,"angle":0},{"index":70,"text":"be superior in quality while being more parallelizable and requiring significantly","x":143.87,"y":305.58,"width":324.62,"height":9.96,"angle":0},{"index":71,"text":"less time to train. Our model achieves 28.4 BLEU on the WMT 2014 English-","x":143.87,"y":294.67,"width":325.92,"height":9.96,"angle":0},{"index":72,"text":"to-German translation task, improving over the existing best results, including","x":143.87,"y":283.76,"width":324.26,"height":9.96,"angle":0},{"index":73,"text":"ensembles, by over 2 BLEU. On the WMT 2014 English-to-French translation task,","x":143.87,"y":272.85,"width":325.51,"height":9.96,"angle":0},{"index":74,"text":"our model establishes a new single-model state-of-the-art BLEU score of 41.8 after","x":143.87,"y":261.94,"width":324.44,"height":9.96,"angle":0},{"index":75,"text":"training for 3.5 days on eight GPUs, a small fraction of the training costs of the","x":143.87,"y":251.03,"width":324.26,"height":9.96,"angle":0},{"index":76,"text":"best models from the literature. We show that the Transformer generalizes well to","x":143.87,"y":240.13,"width":324.27,"height":9.96,"angle":0},{"index":77,"text":"other tasks by applying it successfully to English constituency parsing both with","x":143.87,"y":229.22,"width":324.27,"height":9.96,"angle":0},{"index":78,"text":"large and limited training data.","x":143.87,"y":218.31,"width":122.4,"height":9.96,"angle":0},{"index":79,"text":"","x":119.82,"y":189.95,"width":0,"height":5.98,"angle":0},{"index":80,"text":"∗","x":119.82,"y":189.95,"width":3.82,"height":5.98,"angle":0},{"index":81,"text":"Equal contribution. Listing order is random. Jakob proposed replacing RNNs with self-attention and started","x":124.14,"y":186.15,"width":379.86,"height":8.97,"angle":0},{"index":82,"text":"the effort to evaluate this idea. Ashish, with Illia, designed and implemented the first Transformer models and","x":108,"y":176.18,"width":396,"height":8.97,"angle":0},{"index":83,"text":"has been crucially involved in every aspect of this work. Noam proposed scaled dot-product attention, multi-head","x":108,"y":166.22,"width":396,"height":8.97,"angle":0},{"index":84,"text":"attention and the parameter-free position representation and became the other person involved in nearly every","x":108,"y":156.26,"width":396.31,"height":8.97,"angle":0},{"index":85,"text":"detail. Niki designed, implemented, tuned and evaluated countless model variants in our original codebase and","x":108,"y":146.29,"width":396,"height":8.97,"angle":0},{"index":86,"text":"tensor2tensor. Llion also experimented with novel model variants, was responsible for our initial codebase, and","x":108,"y":136.33,"width":396,"height":8.97,"angle":0},{"index":87,"text":"efficient inference and visualizations. Lukasz and Aidan spent countless long days designing various parts of and","x":108,"y":126.37,"width":396,"height":8.97,"angle":0},{"index":88,"text":"implementing tensor2tensor, replacing our earlier codebase, greatly improving results and massively accelerating","x":108,"y":116.41,"width":396,"height":8.97,"angle":0},{"index":89,"text":"our research.","x":108,"y":106.44,"width":46.3,"height":8.97,"angle":0},{"index":90,"text":"","x":120.21,"y":99.3,"width":0,"height":5.98,"angle":0},{"index":91,"text":"†","x":120.21,"y":99.3,"width":3.43,"height":5.98,"angle":0},{"index":92,"text":"Work performed while at Google Brain.","x":124.14,"y":95.5,"width":143.21,"height":8.97,"angle":0},{"index":93,"text":"","x":120.21,"y":88.36,"width":0,"height":5.98,"angle":0},{"index":94,"text":"‡","x":120.21,"y":88.36,"width":3.43,"height":5.98,"angle":0},{"index":95,"text":"Work performed while at Google Research.","x":124.14,"y":84.55,"width":156.15,"height":8.97,"angle":0},{"index":96,"text":"31st Conference on Neural Information Processing Systems (NIPS 2017), Long Beach, CA, USA.","x":108,"y":52.12,"width":352.14,"height":8.97,"angle":0},{"index":97,"text":"","x":32,"y":237,"width":0,"height":20,"angle":90},{"index":98,"text":"arXiv:1706.03762v7 [cs.CL] 2 Aug 2023","x":32,"y":237,"width":341.08,"height":20,"angle":90}]}